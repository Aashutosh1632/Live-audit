          "type": "question",
          "settings": {
            "category": "Orders",
            "question": "Do I need to open an account to shop on your website?",
            "answer": "<p>No, you don’t need to open an account to place an order on our website. Simply checkout as a guest and provide the necessary details for us to process and deliver your order.<br/><br/>Note: We try to honor your delivery instructions whenever possible. However, we can't always guarantee that our carriers can meet these requests.<br/></p>"
          }
