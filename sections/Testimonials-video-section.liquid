<style>
  #shopify-section-{{ section.id }} .new-videos {
    display: grid;
    column-gap: 20px;
    row-gap: 30px;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
  }

  @media only screen and (max-width: 860px) {
    #shopify-section-{{ section.id }} .new-videos {
      display: grid;
      column-gap: 20px;
      row-gap: 20px;
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }

  #shopify-section-{{ section.id }} .Vid iframe,
  #shopify-section-{{ section.id }} .Vid .video-element {
    width: 100%;
    aspect-ratio: 9 / 16;
    display: block;
    border: none;
  }
</style>

<div class="page__container page-width">
  <h1 class="vid-head">{{ section.settings.heading }}</h1>
  <div class="new-videos">
    {% for block in section.blocks %}
      <div class="Vid" {{ block.shopify_attributes }}>

        {% if block.settings.video_type == 'youtube' %}
          {% assign yt_url = block.settings.youtube_url %}
          {% assign embed_url = '' %}

          {% if yt_url contains 'youtu.be/' %}
            {% assign video_id = yt_url | split: 'youtu.be/' | last | split: '?' | first %}
          {% elsif yt_url contains 'watch?v=' %}
            {% assign video_id = yt_url | split: 'watch?v=' | last | split: '&' | first %}
          {% elsif yt_url contains '/shorts/' %}
            {% assign video_id = yt_url | split: '/shorts/' | last | split: '?' | first %}
          {% else %}
            {% assign video_id = '' %}
          {% endif %}

          {% if video_id != '' %}
            <iframe
              src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&loop=1&playlist={{ video_id }}&playsinline=1&controls=1"
              allow="autoplay; encrypted-media"
              allowfullscreen
              loading="lazy"
              title="{{ block.settings.head | escape }}"
            ></iframe>
          {% endif %}

        {% else %}
          {% if block.settings.video != blank %}
            <video class="video-element" autoplay muted loop playsinline controls>
              <source src="{{ block.settings.video | escape }}" type="video/mp4">
            </video>
          {% endif %}
        {% endif %}

        {% if block.settings.head != blank %}
          <h2 class="vid-h2">{{ block.settings.head }}</h2>
        {% endif %}
        {% if block.settings.subhead != blank %}
          <p class="vid-p">{{ block.settings.subhead }}</p>
        {% endif %}

      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials-video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "columns_desktop",
      "min": 3,
      "max": 7,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "select",
          "id": "video_type",
          "label": "Video Type",
          "options": [
            { "value": "mp4", "label": "MP4 (Shopify Files)" },
            { "value": "youtube", "label": "YouTube" }
          ],
          "default": "mp4"
        },
        {
          "type": "url",
          "id": "video",
          "label": "MP4 Video (from Shopify Files)"
        },
        {
          "type": "text",
          "id": "youtube_url",
          "label": "YouTube URL",
          "info": "Supports youtube.com/watch?v=, youtu.be/, and /shorts/ links"
        },
        {
          "type": "text",
          "id": "head",
          "label": "Head"
        },
        {
          "type": "text",
          "id": "subhead",
          "label": "Subhead"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials-video"
    }
  ]
}
{% endschema %}
