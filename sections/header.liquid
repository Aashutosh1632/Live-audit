      <div class="site-header-right {% if customer %}acc-opncu{% else %}not-acc-opncu{% endif %}">
        <ul class="site-header-actions cst-drp-acc">
          {%- if shop.customer_accounts_enabled -%}
            {%- if customer -%}
              {%- if customer.b2b? -%}
                <li class="site-header-actions__account-link">
                  <a class="site-header_account-link-anchor" href="https://thankyou.deodap.in/">
                    <span class="site-header__account-icon">{%- render 'kp-icon', id: 'icon-account' -%}</span>
                    <span class="site-header_account-link-text mb-acct mb-acct--b2b">My Account</span>
                  </a>
                </li>
              {%- else -%}
                <li class="site-header-actions__account-link acct-tab kplogin">
                  <a class="site-header_account-link-anchor" href="/account">
                    <span class="site-header__account-icon">{%- render 'kp-icon', id: 'icon-account' -%}</span>
                   
                    <span class="site-header_account-link-text mb-acct">My Account</span>
                    {%- render 'icon-account-chevron-dec' -%}
                  </a>
                </li>
              {%- endif -%}
            {%- else -%}
              <li class="site-header-actions__account-link kplogin">
                <a class="site-header_account-link-anchor" href="/account">
                  <span class="site-header__account-icon">{%- render 'kp-icon', id: 'icon-account' -%}</span>
                 
                  <span class="site-header_account-link-text mb-acct">LOGIN</span>
                  {%- render 'icon-account-chevron-dec' -%}
                </a>
              </li>
            {%- endif -%}
            <div class="show-acc-tab">
              <a class="close-acc-tab">
                <svg height="20" viewBox="0 0 512 512" width="20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M464 32H48C21.5 32 0 53.5 0 80v352c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48V80c0-26.5-21.5-48-48-48zm-83.6 290.5c4.8 4.8 4.8 12.6 0 17.4l-40.5 40.5c-4.8 4.8-12.6 4.8-17.4 0L256 313.3l-66.5 67.1c-4.8 4.8-12.6 4.8-17.4 0l-40.5-40.5c-4.8-4.8-4.8-12.6 0-17.4l67.1-66.5-67.1-66.5c-4.8-4.8-4.8-12.6 0-17.4l40.5-40.5c4.8-4.8 12.6-4.8 17.4 0l66.5 67.1 66.5-67.1c4.8-4.8 12.6-4.8 17.4 0l40.5 40.5c4.8 4.8 4.8 12.6 0 17.4L313.3 256l67.1 66.5z" fill="#6e6e6e"/>
                </svg>
                Close
              </a>
              {%- render 'header-account-tab' -%}
            </div>
          {%- endif -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {%- render block -%}
        {%- endcase -%}
      {%- endfor -%}

      <div class="header-wishlist">
        <a href="javascript:void(0)" class="header__icon h-wishlist-icon wishlist-page-widget">
          <svg class="icon" fill="none" height="24" overflow="unset" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path style="stroke: #fff;" d="M12.4869 22C12.2364 21.9968 11.9918 21.9232 11.7804 21.7875C8.18822 19.57 5.48518 17.3766 3.2783 14.8705C2.01853 13.5287 1.04215 11.942 0.408559 10.207C-0.730606 6.84675 0.5832 2.9211 3.46882 1.07256C4.78425 0.221399 6.35422 -0.134962 7.90363 0.0659208C9.45304 0.266804 10.8831 1.01212 11.9431 2.17126C12.1376 2.37977 12.3162 2.60031 12.4869 2.81685C12.7194 2.51694 12.97 2.2317 13.2371 1.96275C13.8816 1.32075 14.6473 0.816306 15.4888 0.479444C16.3303 0.142583 17.2302 -0.0198119 18.1351 0.00192686C19.0214 0.0266866 19.8936 0.23235 20.6992 0.606539C21.5048 0.980728 22.2271 1.51571 22.8227 2.17928C25.0693 4.63732 25.6012 7.62065 24.3072 10.8045C23.6255 12.404 22.6611 13.8647 21.4613 15.1151C19.3548 17.3836 16.9713 19.3724 14.3683 21.0336C14.019 21.2662 13.6578 21.4907 13.3006 21.7113L13.1934 21.7795C12.9825 21.9174 12.738 21.9937 12.4869 22Z" stroke="currentColor" stroke-width="2"></path>
          </svg>
          <span class="wishlist-h-count wishlist-total-count" data-total="0">0</span>
        </a>
      </div>

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </header>

  <div class="mobile-utility-bar">{% render 'header-bottom-bar' %}</div>

</{% if section.settings.sticky_header_type != 'none' %}sticky-header{% else %}div{% endif %}>

