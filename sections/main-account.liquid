            Logout
          </a>
        </div>

        <div class="custom-rig-ads">
          {%- paginate customer.addresses by 5 -%}
          <div class="custom-adrs-act customer addresses section-{{ section.id }}-padding" data-customer-addresses>
            <ul role="list" class="cst-deaf-add">
              {%- for address in customer.addresses -%}
                <li data-address>
                  {{ address | format_address }}
                  {%- if address == customer.default_address -%}
                    <p class="defa-text">{{ 'customer.addresses.default' | t }}</p>
                  {%- endif -%}
                  <button
                    type="button"
                    id="EditFormButton_{{ address.id }}"
                    aria-label="{{ 'customer.addresses.edit_address' | t }} {{ forloop.index }}"
                    aria-controls="EditAddress_{{ address.id }}"
                    aria-expanded="false"
                    data-address-id="{{ address.id }}"
                    class="edit-btncst"
                  >{{ 'customer.addresses.edit' | t }}</button>
                  <button
                    type="button"
                    aria-label="{{ 'customer.addresses.delete' | t }} {{ forloop.index }}"
                    data-target="{{ address.url }}"
                    data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
                    class="dlt-btncst"
                  >{{ 'customer.addresses.delete' | t }}</button>

                  <div class="cst-edit-address" id="EditAddress_{{ address.id }}">
                    <h2>{{ 'customer.addresses.edit_address' | t }}</h2>
                    {%- form 'customer_address', address -%}
                      <div class="field">
                        <input type="text" class="input-border" id="AddressFirstName_{{ form.id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder="{{ 'customer.addresses.first_name' | t }}" required>
                        <label for="AddressFirstName_{{ form.id }}">{{ 'customer.addresses.first_name' | t }}</label>
                      </div>
                      <div class="field">
                        <input type="text" class="input-border" id="AddressLastName_{{ form.id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder="{{ 'customer.addresses.last_name' | t }}" required>
                        <label for="AddressLastName_{{ form.id }}">{{ 'customer.addresses.last_name' | t }}</label>
                      </div>
                      <div class="field">
                        <input type="text" class="input-border" id="AddressCompany_{{ form.id }}" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder="{{ 'customer.addresses.company' | t }}">
                        <label for="AddressCompany_{{ form.id }}">{{ 'customer.addresses.company' | t }}</label>
                      </div>
                      <div class="field">
                        <input type="text" class="input-border" id="AddressAddress1_{{ form.id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="{{ 'customer.addresses.address1' | t }}" required>
                        <label for="AddressAddress1_{{ form.id }}">{{ 'customer.addresses.address1' | t }}</label>
                      </div>
                      <div class="field">
                        <input type="text" class="input-border" id="AddressAddress2_{{ form.id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="{{ 'customer.addresses.address2' | t }}">
                        <label for="AddressAddress2_{{ form.id }}">{{ 'customer.addresses.address2' | t }}</label>
                      </div>
                      <div class="field">
                        <input type="text" class="input-border" id="AddressCity_{{ form.id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="{{ 'customer.addresses.city' | t }}">
                        <label for="AddressCity_{{ form.id }}">{{ 'customer.addresses.city' | t }}</label>
                      </div>
                      <div>
                        <label for="AddressCountry_{{ form.id }}">{{ 'customer.addresses.country' | t }}</label>
                        <div class="select">
                          <select id="AddressCountry_{{ form.id }}" class="input-border" name="address[country]" data-address-country-select data-default="{{ form.country }}" data-form-id="{{ form.id }}" autocomplete="country">
                            {{ all_country_option_tags }}
                          </select>
                          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                        </div>
                      </div>
                      <div id="AddressProvinceContainer_{{ form.id }}" style="display:none;">
                        <label for="AddressProvince_{{ form.id }}">{{ 'customer.addresses.province' | t }}</label>
                        <div class="select">
                          <select id="AddressProvince_{{ form.id }}" class="input-border" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
                          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                        </div>
                      </div>
                      <div class="field">
                        <input type="text" id="AddressZip_{{ form.id }}" class="input-border" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="{{ 'customer.addresses.zip' | t }}">
                        <label for="AddressZip_{{ form.id }}">{{ 'customer.addresses.zip' | t }}</label>
                      </div>
                      <div class="field">
                        <input type="tel" id="AddressPhone_{{ form.id }}" class="input-border" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="{{ 'customer.addresses.phone' | t }}" required>
                        <label for="AddressPhone_{{ form.id }}">{{ 'customer.addresses.phone' | t }}</label>
                      </div>
                      <div>
                        {{ form.set_as_default_checkbox }}
                        <label for="address_default_address_{{ form.id }}">{{ 'customer.addresses.set_default' | t }}</label>
                      </div>
                      <div>
                        <button class="cst-editsub">{{ 'customer.addresses.update' | t }}</button>
                        <button class="cst-editclear" type="reset">{{ 'customer.addresses.cancel' | t }}</button>
                      </div>
                    {%- endform -%}
                  </div>
                </li>
              {%- endfor -%}
            </ul>

            <div data-address>
              <button class="new-acc" type="button" aria-expanded="false" aria-controls="AddAddress">
                + {{ 'customer.addresses.add_new' | t }}
              </button>
              <div class="custom-form-style hidden cst-form">
                <div id="AddAddress">
                  <h2 id="AddressNewHeading">{{ 'customer.addresses.add_new' | t }}</h2>
                  {%- form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading' -%}
                    <div class="field">
                      <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder="{{ 'customer.addresses.first_name' | t }}" required>
                      <label for="AddressFirstNameNew">{{ 'customer.addresses.first_name' | t }}</label>
                    </div>
                    <div class="field">
                      <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder="{{ 'customer.addresses.last_name' | t }}" required>
                      <label for="AddressLastNameNew">{{ 'customer.addresses.last_name' | t }}</label>
                    </div>
                    <div class="field">
                      <input type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" autocomplete="organization" placeholder="{{ 'customer.addresses.company' | t }}">
                      <label for="AddressCompanyNew">{{ 'customer.addresses.company' | t }}</label>
                    </div>
                    <div class="field">
                      <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="{{ 'customer.addresses.address1' | t }}" required>
                      <label for="AddressAddress1New">{{ 'customer.addresses.address1' | t }}</label>
                    </div>
                    <div class="field">
                      <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="{{ 'customer.addresses.address2' | t }}">
                      <label for="AddressAddress2New">{{ 'customer.addresses.address2' | t }}</label>
                    </div>
                    <div class="custom-spacing-form">
                      <div class="field custom-spacing-form-sub">
                        <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="{{ 'customer.addresses.city' | t }}">
                        <label for="AddressCityNew">{{ 'customer.addresses.city' | t }}</label>
                      </div>
                      <div class="custom-spacing-form-sub">
                        <div class="select">
                          <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" autocomplete="country" required>
                            {{ all_country_option_tags }}
                          </select>
                          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                        </div>
                      </div>
                    </div>
                    <div class="custom-spacing-form">
                      <div class="custom-spacing-form-sub" id="AddressProvinceContainerNew" style="display:none;">
                        <div class="select">
                          <select id="AddressProvinceNew" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select>
                          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                        </div>
                      </div>
                      <div class="field custom-spacing-form-sub zip-add-cst">
                        <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="{{ 'customer.addresses.zip' | t }}">
                        <label for="AddressZipNew">{{ 'customer.addresses.zip' | t }}</label>
                      </div>
                    </div>
                    <div class="custom-spacing-form">
                      <div class="field custom-spacing-form-sub">
                        <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="{{ 'customer.addresses.phone' | t }}" required>
                        <label for="AddressPhoneNew">{{ 'customer.addresses.phone' | t }}</label>
                      </div>
                      <div class="custom-spacing-form-sub">
                        {{ form.set_as_default_checkbox }}
                        <label class="lbl-clr" for="address_default_address_new">{{ 'customer.addresses.set_default' | t }}</label>
                      </div>
                    </div>
                    <div class="form-btn-wrap">
                      <button class="add-addres-btn">{{ 'customer.addresses.add' | t }}</button>
                      <button class="add-addres-btn close_form">Close</button>
                    </div>
                  {%- endform -%}
                </div>
              </div>
            </div>

            {%- if paginate.pages > 1 and paginate.parts.size > 0 -%}
              <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
                <ul role="list">
                  {%- if paginate.previous -%}
                    <li>
                      <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                      </a>
                    </li>
                  {%- endif -%}
                  {%- for part in paginate.parts -%}
                    <li>
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
                      {%- elsif part.title == paginate.current_page -%}
                        <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
                      {%- else -%}
                        <span>{{ part.title }}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                  {%- if paginate.next -%}
                    <li>
                      <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              </nav>
            {%- endif -%}
          </div>
          {%- endpaginate -%}
        </div>

        <div class="custom-orderr">{%- render 'new-order' -%}</div>
        <div class="custom-contant">{%- render 'custom-contact' -%}</div>
        <div class="custom-recently-viewed">{%- render 'custom-recently-viewed' -%}</div>
        <div class="custom-top-selling">{%- render 'custom-best-selling' -%}</div>
        <div class="custom-track-ord">
          <h2 class="trk-head">Track Your Order</h2>
          <p class="trk-con">Track order easily with your details and stay updated on the latest delivery status! To track your order, please click the button below.</p>
          <a class="trk-btn" href="https://deodap.in/pages/shipment-tracking" target="_blank" rel="noopener">Click Here</a>
        </div>
        <div class="custom-tickets-api">{%- render 'care-tickets-api' -%}</div>

      </div>
    </div>
  </div>
</section>

<script>
  window.addEventListener('load', function() {
    if (typeof CustomerAddresses !== 'undefined') new CustomerAddresses();
  });

  document.addEventListener('DOMContentLoaded', function() {
    var customAdd             = document.querySelector('.custom-rig-ads');
    var customOrderDiv        = document.querySelector('.custom-orderr');
    var customContactDiv      = document.querySelector('.custom-contant');
    var customRecentlyViewed  = document.querySelector('.custom-recently-viewed');
    var customTopSelling      = document.querySelector('.custom-top-selling');
    var customTrackOrder      = document.querySelector('.custom-track-ord');
    var customTickets         = document.querySelector('.custom-tickets-api');
    var allLinks              = document.querySelectorAll('.cstm-a');
    var subtitleText          = document.getElementById('subtitle-text');
    var newAccBtn             = document.querySelector('.new-acc');
    var cstForm               = document.querySelector('.cst-form');
    var closeFormBtn          = document.querySelector('.close_form');

    // ── Add new address form toggle ──
    if (newAccBtn && cstForm) {
      newAccBtn.addEventListener('click', function() {
        cstForm.classList.toggle('hidden');
        newAccBtn.setAttribute('aria-expanded', !cstForm.classList.contains('hidden'));
      });
    }
    if (closeFormBtn && cstForm) {
      closeFormBtn.addEventListener('click', function(e) {
        e.preventDefault();
        cstForm.classList.add('hidden');
        if (newAccBtn) newAccBtn.setAttribute('aria-expanded', 'false');
      });
    }

    // ── Mega menu hover (inline menu) ──
    var inlineMenu = document.querySelector('.header__inline-menu');
    if (inlineMenu) {
      inlineMenu.querySelectorAll('details').forEach(function(el) {
        el.addEventListener('mouseover', function() {
          el.setAttribute('open', true);
          var ul = el.querySelector('ul');
          if (ul) ul.addEventListener('mouseleave', function() { el.removeAttribute('open'); });
          el.addEventListener('mouseleave', function() { el.removeAttribute('open'); });
        });
      });
    }

    // ── Tab switching ──
    function hideAllSections() {
      customAdd.style.display = 'none';
      customOrderDiv.style.display = 'none';
      customContactDiv.style.display = 'none';
      customRecentlyViewed.style.display = 'none';
      customTopSelling.style.display = 'none';
      customTrackOrder.style.display = 'none';
      customTickets.style.display = 'none';
    }

    function removeActiveClass() {
      allLinks.forEach(function(l) { l.classList.remove('active'); });
      document.querySelectorAll('.header-cstm-a').forEach(function(l) { l.classList.remove('active'); });
    }

    function activateTab(tabName) {
      hideAllSections();
      removeActiveClass();

      var linkToActivate = document.querySelector('.cstm-a[href*="' + tabName + '"]');
      var headerLink = document.querySelector('.header-cstm-a[href*="' + tabName + '"]');
      if (linkToActivate) {
        linkToActivate.classList.add('active');
        subtitleText.textContent = linkToActivate.getAttribute('data-subtitle') || '';
      }
      if (headerLink) headerLink.classList.add('active');

      switch (tabName) {
        case 'my_order':        customOrderDiv.style.display = 'block'; break;
        case 'contact':         customContactDiv.style.display = 'block'; break;
        case 'recently_viewed': customRecentlyViewed.style.display = 'block'; break;
        case 'top_order_products': customTopSelling.style.display = 'block'; break;
        case 'track_order':     customTrackOrder.style.display = 'block'; break;
        case 'tickets':         customTickets.style.display = 'block'; break;
        default:
          customAdd.style.display = 'block';
          var defaultLink = document.querySelector(".cstm-a[href='/account']");
          var defaultHeaderLink = document.querySelector(".header-cstm-a[href='/account']");
          if (defaultLink) { defaultLink.classList.add('active'); subtitleText.textContent = defaultLink.getAttribute('data-subtitle') || ''; }
          if (defaultHeaderLink) defaultHeaderLink.classList.add('active');
      }
    }
    var activeTab = new URLSearchParams(window.location.search).get('tab');
    activateTab(activeTab || '');
    allLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        var tab = (link.getAttribute('href').split('=')[1] || '');
        if (tab) {
          e.preventDefault();
          history.pushState(null, '', '/account?tab=' + tab);
          activateTab(tab);
        } else {
          removeActiveClass();
          link.classList.add('active');
          history.pushState(null, '', '/account');
          subtitleText.textContent = link.getAttribute('data-subtitle') || '';
          hideAllSections();
          customAdd.style.display = 'block';
        }
      });
    });
    document.addEventListener('click', function(e) {
      if (e.target.matches('.header-cstm-a')) {
        var tab = (e.target.getAttribute('href').split('=')[1] || '');
        if (tab) {
          e.preventDefault();
          history.pushState(null, '', '/account?tab=' + tab);
          activateTab(tab);
        }
      }
    });
  });
</script> {% endcomment %}
