<script>
window.addEventListener('load', function () {
  if (typeof CustomerAddresses !== 'undefined') new CustomerAddresses();
});

document.addEventListener('DOMContentLoaded', function () {

  /* ── Accordion ── */
  document.querySelectorAll('[data-card-toggle]').forEach(function (toggle) {
    toggle.addEventListener('click', function () {
      var card = toggle.closest('[data-card]');
      var isOpen = card.classList.contains('open');

      // Close all first
      document.querySelectorAll('[data-card]').forEach(function (c) {
        c.classList.remove('open');
        c.querySelector('[data-card-toggle]').setAttribute('aria-expanded', 'false');
      });

      // If it was closed, open it now
      if (!isOpen) {
        card.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
        setTimeout(function () {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 50);
      }
    });

    // Keyboard
    toggle.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle.click(); }
    });
  });

  /* ── Add new address toggle ── */
  var newAccBtn    = document.querySelector('.new-acc');
  var addAddrForm  = document.getElementById('AddAddress');
  var closeFormBtn = document.querySelector('.close_form');

  if (newAccBtn && addAddrForm) {
    newAccBtn.addEventListener('click', function () {
      addAddrForm.classList.toggle('hidden');
      newAccBtn.setAttribute('aria-expanded', !addAddrForm.classList.contains('hidden'));
    });
  }
  if (closeFormBtn && addAddrForm) {
    closeFormBtn.addEventListener('click', function (e) {
      e.preventDefault();
      addAddrForm.classList.add('hidden');
      if (newAccBtn) newAccBtn.setAttribute('aria-expanded', 'false');
    });
  }

  /* ── Auto-open from URL ?tab= ── */
  var activeTab = new URLSearchParams(window.location.search).get('tab');
  if (activeTab) {
    var target = document.querySelector('[data-card="' + activeTab + '"]');
    if (target) {
      target.classList.add('open');
      target.querySelector('[data-card-toggle]').setAttribute('aria-expanded', 'true');
    }
  }

});

/* ════════════════════════════════════════════════════════
   Account Card: pdp-slick with 2 slides
════════════════════════════════════════════════════════ */
(function initAccRvSlick() {
  var card = document.querySelector('[data-card="recently_viewed"]');
  if (!card) return;

  var slickTarget = card.querySelector('.js-pdp-viewed');
  if (!slickTarget) return;

  /* Wait for recently-viewed-product.js to populate + init Slick */
  var attempts = 0;
  var maxAttempts = 30; /* 3 seconds max */

  var poll = setInterval(function () {
    attempts++;

    var $ = window.jQuery;
    if (!$ || !$.fn || !$.fn.slick) {
      if (attempts >= maxAttempts) clearInterval(poll);
      return; /* Slick not loaded yet */
    }

    var $slider = $(slickTarget);

    /* Wait until slick is initialized AND has at least 1 slide */
    var isSlickInit = $slider.hasClass('slick-initialized');
    var hasSlides   = slickTarget.querySelectorAll('.slick-slide:not(.slick-cloned)').length > 0;

    if (!isSlickInit || !hasSlides) {
      if (attempts >= maxAttempts) clearInterval(poll);
      return;
    }

    clearInterval(poll);

    /* Destroy existing instance, re-init with account card settings */
    $slider.slick('unslick');

$slider.slick({
  slidesToShow  : 2,
  slidesToScroll: 1,
  infinite      : true,
  arrows        : true,
  dots          : false,   /* ← removes bullet dots completely */
  adaptiveHeight: false,
  swipeToSlide  : true,

  /* Custom SVG caret arrows instead of "Previous / Next" text */
  prevArrow: '<button type="button" class="acc-slick-prev slick-prev" aria-label="Previous">'
           + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="15 18 9 12 15 6"/></svg>'
           + '</button>',
  nextArrow: '<button type="button" class="acc-slick-next slick-next" aria-label="Next">'
           + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="9 18 15 12 9 6"/></svg>'
           + '</button>',

  responsive: [
    {
      breakpoint: 480,
      settings: { slidesToShow: 1, slidesToScroll: 1 }
    }
  ]
});

  }, 100); /* poll every 100ms */

})();
</script>







