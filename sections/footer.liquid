<script>
document.addEventListener("DOMContentLoaded", function () {
  if (window.innerWidth <= 749) {

    let footerWrapper = document.querySelector(".footer__blocks-wrapper");

    if (!footerWrapper) return;

    let menuBlocks = footerWrapper.querySelectorAll(".footer-block--menu");

    if (menuBlocks.length >= 4) {

      // Create main accordion wrapper
      let mainAccordion = document.createElement("div");
      mainAccordion.classList.add("footer-main-accordion");

      // Header
      let header = document.createElement("div");
      header.classList.add("footer-main-header");
      header.innerHTML = `
        <h2 class="abcd">Menu Links</h2>
        <span class="accordion--icon">▼</span>
      `;

      // Content wrapper
      let content = document.createElement("div");
      content.classList.add("footer-main-content");

      // Move first 4 menu blocks inside
      for (let i = 0; i < 4; i++) {
        content.appendChild(menuBlocks[i]);
      }

      mainAccordion.appendChild(header);
      mainAccordion.appendChild(content);

      // Insert at top
      footerWrapper.prepend(mainAccordion);

      // Toggle behavior
      header.addEventListener("click", function () {
        content.classList.toggle("active");
        header.classList.toggle("active");
      });
    }
  }
});
</script>

<style>
  @media (max-width: 749px) {

  .footer-main-content {
    display: none;
  }

  .footer-main-content.active {
    display: block;
  }

  .footer-main-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .footer-main-header.active .accordion--icon {
    transform: rotate(180deg);
  }

  .footer-main-header .accordion--icon {
    transition: 0.3s;
  }
}

.footer-main-accordion {
    width: 100%;
}

.footer-main-header h2 {
    margin: 20px 0;
    font-size: 18px;
    font-family: helvetica;
    font-weight: 700;
}
h2.abcd {
    margin: 0 !important;
    color:#f32424;  
}
span.accordion--icon {
    color:#f32424;  
}

</style>

