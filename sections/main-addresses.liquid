              <path d="M2.07569 7.25739C1.15626 5.41222 2.08396 3.37584 3.85173 2.31518C4.70284 1.80451 5.80282 2.02613 6.38978 2.82653L7.692 4.60229C8.24626 5.35809 8.3312 6.36043 7.91205 7.19873L7.57061 7.88161C7.47177 8.07929 7.45614 8.30796 7.55725 8.50449C7.74146 8.86255 8.13372 9.49708 8.88938 10.2527C9.64505 11.0084 10.2796 11.4007 10.6376 11.5849C10.8342 11.686 11.0628 11.6704 11.2605 11.5715L11.9434 11.2301C12.7817 10.8109 13.784 10.8959 14.5398 11.4501L16.3156 12.7523C17.116 13.3393 17.3376 14.4393 16.8269 15.2904C15.7663 17.0582 13.7299 17.9859 11.8847 17.0664C10.3296 16.2915 8.34241 15.0091 6.23773 12.9044C4.13306 10.7997 2.85059 8.8125 2.07569 7.25739Z" fill="#6E6E6E"/>
