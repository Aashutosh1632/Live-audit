{{ 'customer.css' | asset_url | stylesheet_tag }}
{{ 'new-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .hidden { display: none; }

  /* Tab content panels — hidden by default via CSS */
  .custom-orderr,
  .custom-contant,
  .custom-recently-viewed,
  .custom-top-selling,
  .custom-track-ord,
  .custom-tickets-api { display: none; }

  /* Track order styles */
  .trk-head { font-size: 24px; font-weight: bold; text-transform: uppercase; }
  .trk-con { font-size: 18px; margin-top: 10px; line-height: 24px; }
  .trk-btn {
    color: white !important;
    text-decoration: none !important;
    font-size: 16px !important;
    font-weight: 600;
    height: 40px;
    width: 120px;
    background-color: #ed2024 !important;
    border: 1px solid #ed2024 !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    margin-top: 15px;
    cursor: pointer !important;
    border-radius: 3px;
  }
  .trk-btn:hover { color: #ed2024 !important; background-color: white !important; }
  @media (max-width: 768px) {
    .trk-head { font-size: 22px; font-weight: 600; }
    .trk-con { font-size: 16px; }
  }
{%- endstyle -%}

<section id="new-acc-add" class="account-page account-page-addresses">
  <div class="top-acc-nm customer account section-{{ section.id }}-padding page-width">
    <h2 class="account-page-subtitle">
      <span class="acc-tabs"><a class="acc-tabs" href="https://deodap.in">Home</a> / </span>
      <span id="subtitle-text">{{ 'customer.addresses.title' | t }}</span>
    </h2>
    <h2 class="acc-wlc">welcome!</h2>
  </div>

  <div class="customer account section-{{ section.id }}-padding">
    <div class="acc-box-sd">
      <h2 class="acc-same-title">Manage my Account</h2>
      <div class="cst-page-con">

        <div class="custom-left-ads">
