<div class="mobile-menu-ttl is-active ">
  <h2 class="mobile-mnu-hed">{{ section.settings.mn_head }}</h2>
  <svg aria-hidden="true" class="icon-chevron-down" fill="none" focusable="false" height="6" role="presentation" viewBox="0 0 8 6" width="8" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 4.5L7 1.5" stroke="currentColor" stroke-linecap="square" stroke-width="1.25"></path>
    <path d="M4 4.5L1 1.5" stroke="currentColor" stroke-linecap="square" stroke-width="1.25"></path>
  </svg>
</div>
<ul class="mobile-main-menu active ">
  {%- for link in section.settings.menu.links -%}
    <li class="mobile-menu-item">
      <div class="mobile-menu-itm-div ">
        <a class="mobile-mnu-tll menu-{{ link.title }}" href="{{ link.url }}">{{ link.title }}</a>
        {%- if link.links != blank -%}
          <span class="mobile-accordion-toggle">
            <svg class="icon-chevron-down" width="8" height="6" viewBox="0 0 8 6">
              <path d="M4 4.5L7 1.5" stroke="currentColor" stroke-width="1.25"></path>
              <path d="M4 4.5L1 1.5" stroke="currentColor" stroke-width="1.25"></path>
            </svg>
          </span>
        {%- endif -%}
      </div>
      {%- if link.links != blank -%}
        <ul class="mobile-submenu">
          {%- for sublink in link.links -%}
            <li class="mobile-submenu-item">
              <div class="mobile-secmenu-itm-div">
                <a class="mobile-mnu-tll menu-{{ sublink.title }}" href="{{ sublink.url }}">{{ sublink.title }}</a>
                {%- if sublink.links != blank -%}
                  <span class="mobile-accordion-toggle">
                    <svg class="icon-chevron-down" width="8" height="6" viewBox="0 0 8 6">
                      <path d="M4 4.5L7 1.5" stroke="currentColor" stroke-width="1.25"></path>
                      <path d="M4 4.5L1 1.5" stroke="currentColor" stroke-width="1.25"></path>
                    </svg>
                  </span>
                {%- endif -%}
              </div>
              {%- if sublink.links != blank -%}
                <ul class="mobile-sub-submenu">
                  {%- for sub_sublink in sublink.links -%}
                    <li><a class="mobile-mnu-tll menu-{{ sub_sublink.title }}" href="{{ sub_sublink.url }}">{{ sub_sublink.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>