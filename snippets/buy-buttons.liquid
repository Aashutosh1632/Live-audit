          <path d="M8.94293 3.00005C8.94293 3.60005 8.33317 4.20005 7.72342 4.20005C7.11366 4.20005 6.50391 3.60005 6.50391 3.00005C6.50391 2.40005 7.11366 1.80005 7.72342 1.80005C8.33317 1.80005 8.94293 2.20005 8.94293 3.00005Z" fill="#ED2125"/>
          <path d="M2.64228 3.00005C2.64228 3.60005 2.03252 4.20005 1.42276 4.20005C0.609756 4.20005 0 3.60005 0 3.00005C0 2.40005 0.609756 1.80005 1.21951 1.80005C2.03252 1.80005 2.64228 2.20005 2.64228 3.00005Z" fill="#ED2125"/>
        </svg>
      </div>
      <div class="order-box">
        {% render 'order-delivery-svg2' %}
        <h5 id="orderready" class="oredrtext"></h5>
        <h5 class="oredr-text">Order Ready</h5>
      </div>
      <div class="difRent_SVg">
        <svg width="25" height="6" viewBox="0 0 25 6" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.325 2.39648e-05L24.39 2.20002C24.9998 2.60002 24.9998 3.40002 24.39 3.60002L20.325 5.80002C19.7152 6.20002 19.1055 5.80002 19.1055 5.20002V0.800024C19.1055 0.200024 19.7152 -0.199976 20.325 2.39648e-05Z" fill="#ED2125"/>
          <path d="M15.2437 3.00005C15.2437 3.60005 14.634 4.20005 14.0242 4.20005C13.4144 4.20005 12.8047 3.60005 12.8047 3.00005C12.8047 2.40005 13.4144 1.80005 14.0242 1.80005C14.634 1.80005 15.2437 2.20005 15.2437 3.00005Z" fill="#ED2125"/>
          <path d="M8.94293 3.00005C8.94293 3.60005 8.33317 4.20005 7.72342 4.20005C7.11366 4.20005 6.50391 3.60005 6.50391 3.00005C6.50391 2.40005 7.11366 1.80005 7.72342 1.80005C8.33317 1.80005 8.94293 2.20005 8.94293 3.00005Z" fill="#ED2125"/>
          <path d="M2.64228 3.00005C2.64228 3.60005 2.03252 4.20005 1.42276 4.20005C0.609756 4.20005 0 3.60005 0 3.00005C0 2.40005 0.609756 1.80005 1.21951 1.80005C2.03252 1.80005 2.64228 2.20005 2.64228 3.00005Z" fill="#ED2125"/>
        </svg>
      </div>
      <div class="order-box">
        {% render 'order-delivery-svg3' %}
        <h5 id="orderdelivery" class="oredrtext"></h5>
        <h5 class="oredr-text">Delivered</h5>
      </div>
    </div>
  </div>
  <script src="{{ 'order-date-calculation.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{{ 'order-date-calculation.css' | asset_url | stylesheet_tag }}
{%- if product.tags contains 'Custom Print'
  or product.tags contains 'Customer print 2'
  or product.tags contains 'CUSTOM PRINT 2'
-%}
  <script>
    $(".product .product-form__buttons .product-customize-atcc-custom-print, .custom-wish-pdp").hide();

    $(document).on("input", ".product-customizer-option input", function () {
      if ($(this).val().trim().length > 0) {
        $(".product .product-form__buttons .product-customize-atcc-custom-print, .custom-wish-pdp").fadeIn();
      } else {
        $(".product .product-form__buttons .product-customize-atcc-custom-print, .custom-wish-pdp").fadeOut();
      }
    });
  </script>
{%- endif -%}
{%- if template.suffix == 'quickshop' -%}
  {%- if product.tags contains 'Custom Print'
  or product.tags contains 'Customer print 2'
  or product.tags contains 'CUSTOM PRINT 2'
-%}
<style>
  .product-customizer-content .product-customizer-option-description,
  .quantity-buy-btn-custom .quantity-part, .quantity-selector__label,button.custom-pdp-btn {display: none;}
</style>
            {% endif %}
{% endif %}

<style>
  .qty-discount-table-box {
    max-width: 330px;
  }
   @media(max-width: 767px){ 
    .qty-discount-table-box {
    max-width: 100%
  }
  }
</style>

{%- if product.tags contains 'Custom Print' or product.tags contains 'Customer print 2' or product.tags contains 'CUSTOM PRINT 2' -%}
  <style>
    .quantity-part {
      display: none !important;
    }
  </style>
{%- endif -%}