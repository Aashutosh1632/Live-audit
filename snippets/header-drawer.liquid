                                  <a href="{{ childlink.url }}" class="menu-drawer__menu-item link list-menu__item focus-inset" {% if childlink.current %}aria-current="page"{% endif %}>
                                    {%- if childlink.type == 'collection_link' and childlink.object.metafields.custom.collection_image_megamenu_ != blank -%}
                                      {{ childlink.object.metafields.custom.collection_image_megamenu_ | image_url: width: 400 | image_tag: widths: '150,250,400,600', sizes: '(min-width: 750px) 200px, 150px', loading: 'lazy', alt: childlink.title, class: 'collection_image' }}
                                    {%- endif -%}
                                    <span class="childlink_title">{{ childlink.title | escape }}</span>
                                  </a>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
            
                          {%- if has_grandchild -%}
                          <div class="menu-drawer__menu list-menu third-lvl-hamburger scrollable-menu" role="list" tabindex="-1">
                            {%- for childlink in use_links -%}
                              {%- if childlink.links.size > 0 -%}
                                <div class="third-lvl-group" id="section-{{ childlink.title | handleize }}">
                                  <h3 class="childlink_title third-lvl-heading"><a href="{{ childlink.url }}">{{ childlink.title | escape }}</a></h3>
                                  <div class="third-hamcoll">
                                    {%- for grandchildlink in childlink.links -%}
                                      <div class="third-divv">
                                        <a href="{{ grandchildlink.url }}" class="menu-drawer__menu-item link list-menu__item focus-inset" {% if grandchildlink.current %}aria-current="page"{% endif %}>
                                          {%- if grandchildlink.type == 'collection_link' and grandchildlink.object.metafields.custom.collection_image_megamenu_ != blank -%}
                                            {{ grandchildlink.object.metafields.custom.collection_image_megamenu_ | image_url: width: 400 | image_tag: widths: '150,250,400,600', sizes: '(min-width: 750px) 200px, 150px', loading: 'lazy', alt: grandchildlink.title, class: 'collection_image' }}
                                          {%- endif -%}
                                          <span class="childlink_title grandchildlink_title {% if grandchildlink.current %}grandchild-curnt{% endif %}">{{ grandchildlink.title | escape }}</span>
                                        </a>
                                      </div>
                                    {%- endfor -%}
                                  </div>
                                </div>
                              {%- else -%}
                                <div class="third-lvl-group">
                                  <h3 class="childlink_title third-lvl-heading"><a href="{{ childlink.url }}">{{ childlink.title | escape }}</a></h3>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                          {%- endif -%}
            
                        </div>
                      </div>
                    </details>
            
                  {%- else -%}
                    <a href="{{ link.url }}" class="menu-drawer__menu-item list-menu__item link focus-inset" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
</div>
          </nav>
