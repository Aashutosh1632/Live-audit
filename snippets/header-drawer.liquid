            <img loading="lazy" decoding="async" src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" width="200" height="{% if product.featured_image.aspect_ratio %}{{ 200 | divided_by: product.featured_image.aspect_ratio | round }}{% else %}200{% endif %}">
            <p class="product-title-header-drawer">{{ product.title }}</p>
          </a>

          <div class="product-price">
            {% if product.compare_at_price > product.price %}
              
              <span class="sale-price" style="color: #e60023; font-weight: bold; font-size:12px;">
                {{ product.price | money }}
              </span>
              <span class="compare-price" style="text-decoration: line-through; color: #888; font-size:12px;">
                {{ product.compare_at_price | money }}
              </span>
            {% else %}
              <span class="regular-price">
                {{ product.price | money }}
              </span>
            {% endif %}
          </div>

        </div> 
      {% endfor %} 

    </div> 
  </div> 
