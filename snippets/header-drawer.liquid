{{ 'mobile-hamburger.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'header-drawer-menu.js' | asset_url }}" defer="defer"></script>

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    {%- comment -%} Perf: heavy mobile drawer content is wrapped in a <template> so the browser does not build it as live DOM during initial page load. On first hamburger click a small inline script clones the template into the live tree and removes the template. Saves DOM/layout/paint work and dramatically reduces JS query times across the site. Bytes on the wire are unchanged (use a true AJAX lazy-load for that). {%- endcomment -%}
    
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <div class="logClose">
                <div class="header__icon header__icon--account link focus-inset small-hide welcome-user customerHeaderLogout">
                  <p class="logo-text">
                    Welcome,
                    {%- if customer.first_name -%}{{ customer.first_name | default: customer.email }} {%- endif -%}
                  </p>
                  <p class="logo-text">
                    Mobile No.:
                    {%- if customer.phone -%}
                      {{ customer.phone }}
                    {%- endif -%}
                  </p>
                </div>
                <a href="/account" class="header__icon header__icon--account link focus-inset small-hide customerHeaderLogin" rel="nofollow"><account-icon><span class="jeet">
