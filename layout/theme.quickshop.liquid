<script>
  let starRatingText = ""
  const temp = setInterval(() => {
    const starRatings = document.querySelectorAll(".jdgm-prev-badge__text")
    const prevBadges = document.querySelectorAll(".jdgm-prev-badge")
    if (jdgmSettings.badge_n_reviews_text) {
      starRatings.forEach((rating, idx) => {
        const reviewCount = prevBadges[idx].dataset.numberOfReviews
        starRatingText = jdgmSettings.badge_n_reviews_text.replace(/\{\{\sn\s\}\}/, reviewCount)
        if (parseInt(reviewCount) > 0) {
          rating.textContent = starRatingText
        }
      })
    }
  }, 5